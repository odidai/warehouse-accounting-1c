                                                           Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого ТекСтрокаТовары Из Товары Цикл
    Отклонение = ТекСтрокаТовары.КоличествоФактическое - ТекСтрокаТовары.КоличествоУчетное;
    ТекСтрокаТовары.Отклонение = Отклонение;
    Если Отклонение = 0 Тогда
        Продолжить;
    КонецЕсли;

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;

		Если Отклонение > 0 Тогда
			// Фактически товара больше, чем по учёту — оприходуем излишек
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Количество = Отклонение;
		Иначе
			// Фактически товара меньше — списываем недостачу
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Количество = -Отклонение;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Склад.Пустая() Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьПоОстаткам();

КонецПроцедуры

Процедура ЗаполнитьПоОстаткам() Экспорт

	Товары.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(, Склад = &Склад) КАК Остатки";
	Запрос.УстановитьПараметр("Склад", Склад);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.КоличествоУчетное = Выборка.КоличествоОстаток;
		НоваяСтрока.КоличествоФактическое = Выборка.КоличествоОстаток;
		НоваяСтрока.Отклонение = 0;
	КонецЦикла;

КонецПроцедуры
                                                               