&НаКлиенте
Процедура ВыгрузитьВ_XML(Команда)

	Если ПустаяСтрока(Объект.ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Укажите путь к файлу для выгрузки");
		Возврат;
	КонецЕсли;

	ВыполнитьВыгрузкуНаСервере(Объект.ПутьКФайлу);
	ПоказатьПредупреждение(, "Выгрузка завершена: " + Объект.ПутьКФайлу);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзXML(Команда)

	Если ПустаяСтрока(Объект.ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Укажите путь к файлу для загрузки");
		Возврат;
	КонецЕсли;

	КоличествоЗагружено = ВыполнитьЗагрузкуНаСервере(Объект.ПутьКФайлу);
	ПоказатьПредупреждение(, "Загрузка завершена. Обработано позиций: " + КоличествоЗагружено);

КонецПроцедуры

&НаСервере
Процедура ВыполнитьВыгрузкуНаСервере(ИмяФайла)

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура");

	Выборка = Справочники.Номенклатура.Выбрать();
	Пока Выборка.Следующий() Цикл

		ЕдиницаНаименование = "";
		Если ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения) Тогда
			ЕдиницаНаименование = Выборка.ЕдиницаИзмерения.Наименование;
		КонецЕсли;

		ЗаписьXML.ЗаписатьНачалоЭлемента("Товар");
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("ЕдиницаИзмерения", ЕдиницаНаименование);
		ЗаписьXML.ЗаписатьАтрибут("ЗакупочнаяЦена", Строка(Выборка.ЗакупочнаяЦена));
		ЗаписьXML.ЗаписатьКонецЭлемента();

	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();

КонецПроцедуры

&НаСервере
Функция ВыполнитьЗагрузкуНаСервере(ИмяФайла)

	СчетчикЗагружено = 0;

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);

	Пока ЧтениеXML.Прочитать() Цикл

		Если ЧтениеXML.Имя = "Товар" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			НаименованиеТовара = ЧтениеXML.ПолучитьАтрибут("Наименование");
			ИмяЕдиницы = ЧтениеXML.ПолучитьАтрибут("ЕдиницаИзмерения");
			ЗакупочнаяЦена = ЧтениеXML.ПолучитьАтрибут("ЗакупочнаяЦена");

			ТоварСсылка = Справочники.Номенклатура.НайтиПоНаименованию(НаименованиеТовара, Истина);
			Если ТоварСсылка.Пустая() Тогда
				НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();
			Иначе
				НовыйТовар = ТоварСсылка.ПолучитьОбъект();
			КонецЕсли;

			НовыйТовар.Наименование = НаименованиеТовара;

			Если Не ПустаяСтрока(ИмяЕдиницы) Тогда
				ЕдиницаСсылка = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(ИмяЕдиницы, Истина);
				Если ЕдиницаСсылка.Пустая() Тогда
					НоваяЕдиница = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
					НоваяЕдиница.Наименование = ИмяЕдиницы;
					НоваяЕдиница.Записать();
					ЕдиницаСсылка = НоваяЕдиница.Ссылка;
				КонецЕсли;
				НовыйТовар.ЕдиницаИзмерения = ЕдиницаСсылка;
			КонецЕсли;

			Если ЗначениеЗаполнено(ЗакупочнаяЦена) Тогда
				НовыйТовар.ЗакупочнаяЦена = Число(ЗакупочнаяЦена);
			КонецЕсли;

			НовыйТовар.Записать();
			СчетчикЗагружено = СчетчикЗагружено + 1;

		КонецЕсли;

	КонецЦикла;

	ЧтениеXML.Закрыть();

	Возврат СчетчикЗагружено;

КонецФункции
